<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the dhikr history and settings, so they follow the user to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="tasbih.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="tasbih.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
